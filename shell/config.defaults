# Shell module configuration defaults.
# Defines hook delimiters, managed shell functions, and Zsh installation defaults.

ZSHRC_HOOK_BEGIN="# >>> env-setup >>>"
ZSHRC_HOOK_END="# <<< env-setup <<<"
ZSHRC_HOOK_LEGACY_BEGIN="# >>> env-setup groovy >>>"
ZSHRC_HOOK_LEGACY_END="# <<< env-setup groovy <<<"
SHELL_FUNCTIONS="ls ssh gss glo gcam"
ZSH_PACKAGE_NAME="zsh"